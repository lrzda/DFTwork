{
  "name": "@dftwork/desktop",
  "version": "0.3.0",
  "private": true,
  "main": "./out/main/index.js",
  "description": "DFTwork 桌面外壳：Electron 主进程 + preload + React 渲染进程",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:e2e": "node --test --test-concurrency=1 tests/desktop.test.cjs",
    "test": "electron-vite build && pnpm test:e2e",
    "package": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@dftwork/shared": "workspace:*",
    "antd": "^5.21.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "three": "^0.170.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "42.11.16",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.5"
  }
}

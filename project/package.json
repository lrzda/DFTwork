{
  "name": "dftwork",
  "version": "0.2.0",
  "private": true,
  "description": "VASP 计算任务工作台：独立桌面软件，AI 可选",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lrzda/DFTwork.git"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --filter @dftwork/desktop dev",
    "build": "pnpm --filter @dftwork/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test:desktop": "pnpm --filter @dftwork/desktop test",
    "core": "cargo build -p vasp-cli --release"
  }
}
